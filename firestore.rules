rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function signedIn(){return request.auth!=null;}
  function teacherExists(){return signedIn()&&exists(/databases/$(database)/documents/teachers/$(request.auth.uid));}
  function teacherData(){return get(/databases/$(database)/documents/teachers/$(request.auth.uid)).data;}
  function isAdmin(){return teacherExists()&&teacherData().role=="admin";}
  function isTeacher(){return teacherExists()&&(teacherData().role=="teacher"||teacherData().role=="admin");}
  function teachesClass(c){return isAdmin()||(isTeacher()&&("classes" in teacherData())&&c in teacherData().classes);}
  match /students/{uid}{
   allow get: if signedIn()&&(request.auth.uid==uid||isAdmin()||teachesClass(resource.data.className));
   allow list: if isAdmin()||(isTeacher()&&("classes" in teacherData())&&resource.data.className in teacherData().classes);
   allow create: if false;
   allow update: if isAdmin()||(isTeacher()&&teachesClass(resource.data.className)&&teachesClass(request.resource.data.className));
   allow delete: if isAdmin()||(isTeacher()&&teachesClass(resource.data.className));
  }
  match /midtermStudents/{uid}{
   allow get: if signedIn()&&(request.auth.uid==uid||isAdmin()||teachesClass(resource.data.className));
   allow list: if isAdmin()||(isTeacher()&&("classes" in teacherData())&&resource.data.className in teacherData().classes);
   allow create: if signedIn()&&request.auth.uid==uid&&request.resource.data.courseId=="midterm-review";
   allow update: if signedIn()&&(request.auth.uid==uid||isAdmin()||(isTeacher()&&teachesClass(resource.data.className)&&teachesClass(request.resource.data.className)));
   allow delete: if isAdmin()||(isTeacher()&&teachesClass(resource.data.className));
  }
  match /teachers/{uid}{allow get: if signedIn()&&(request.auth.uid==uid||isAdmin());allow list: if isAdmin();allow write: if false;}
 }
}