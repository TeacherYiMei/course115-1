rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isTeacher() {
      return signedIn() &&
        exists(/databases/$(database)/documents/teachers/$(request.auth.uid));
    }

    match /students/{studentUid} {
      allow get: if signedIn() && (request.auth.uid == studentUid || isTeacher());
      allow list: if isTeacher();
      allow create, update: if signedIn() && request.auth.uid == studentUid;
      allow delete: if isTeacher();
    }

    match /teachers/{teacherUid} {
      allow read: if signedIn() && request.auth.uid == teacherUid;
      allow write: if false;
    }
  }
}
